{
  "screens": [
    {
      "id": "pages",
      "label": "Pages",
      "tab": "Pages",
      "itemLabel": "page",
      "idField": "page_id",
      "idPrefix": "p",
      "titleFrom": "title",
      "slugFrom": "title",
      "sortable": true,
      "help": "Pages are the regular sections of the website, such as About or Contact. Each page keeps the text and picture you enter here. Use Move up and Move down to change the order of the pages.",
      "impact": "A page appears on the website only while Show on the website is ticked. You can change its web address, and the old address then redirects to the new one.",
      "fields": [
        {
          "key": "title",
          "label": "Page title",
          "type": "text",
          "column": "title",
          "group": "Basics"
        },
        {
          "key": "slug",
          "label": "Web address",
          "type": "slug",
          "column": "slug",
          "help": "Lowercase letters, numbers and dashes. If you change it, visitors on the old address are sent to the new one.",
          "group": "Basics"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "column": "content",
          "group": "Basics"
        },
        {
          "key": "picture",
          "label": "Picture",
          "type": "image",
          "column": "featured_image",
          "group": "Picture"
        },
        {
          "key": "visible",
          "label": "Show on the website",
          "type": "checkbox",
          "column": "status",
          "onValue": "active",
          "offValue": "inactive",
          "default": true,
          "group": "Visibility"
        },
        {
          "key": "hide_at",
          "label": "Hide from the website on",
          "type": "datetime",
          "column": "hide_at",
          "group": "Visibility",
          "help": "Optional. Leave empty to keep it visible. It is hidden automatically at this time."
        },
        {
          "key": "meta_title",
          "label": "Search title",
          "type": "text",
          "column": "meta_title",
          "group": "Search (SEO)",
          "help": "Shown in search results and browser tabs. Keep it under 60 characters."
        },
        {
          "key": "meta_description",
          "label": "Search description",
          "type": "textarea",
          "column": "meta_description",
          "group": "Search (SEO)",
          "help": "A short summary for search results. Aim for 120 to 160 characters."
        },
        {
          "key": "meta_keywords",
          "label": "Keywords",
          "type": "text",
          "column": "meta_keywords",
          "group": "Search (SEO)"
        }
      ],
      "duplicable": false
    },
    {
