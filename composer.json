{
    "name": "knots-and-perl/sheets-cms",
    "description": "Browser-managed static website generator for Knots & Perl",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "aws/aws-sdk-php": "^3.300",
        "google/apiclient": "^2.16",
        "laravel/framework": "^12.0",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan optimize:clear"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
