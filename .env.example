APP_NAME="Knots & Perl CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_DRIVER=file
SESSION_DRIVER=file
FILESYSTEM_DISK=local

# CMS local mode + operator login
CMS_LOCAL_MODE=false
CMS_CONTENT_JSON=storage/app/content.json
# bcrypt hash generated with php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=

# Cloudflare R2 (S3 compatible)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=https://images.knotsandperl.com

# Cloudflare Pages direct deployment (optional when GitHub Actions is used)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=

# GitHub deployment
GITHUB_REPOSITORY=
GITHUB_DEPLOY_TOKEN=
GITHUB_WORKFLOW=deploy.yml
GITHUB_BRANCH=main

# Publishing
PUBLISH_MODE=manual
PUBLISH_STRICT=true
PUBLISH_WEBHOOK_SECRET=
PUBLISH_KEEP_BACKUPS=5
LIVE_SITE_URL=https://knotsandperl.pages.dev

# Image pipeline
IMAGE_MAX_BYTES=8388608
IMAGE_QUALITY=82
IMAGE_RETENTION_DAYS=30
